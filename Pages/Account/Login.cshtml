@page
@model GymGuide.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3 text-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right text-warning me-2"></i> GymGuide Log In</h4>
                <small class="text-secondary">Sign in to access your workout plan and track your progress</small>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" class="form-control" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark">
                            Log In
                        </button>
                    </div>
                </form>

                <div class="alert alert-light border small text-muted">
                    <strong>Demo Credentials:</strong><br>
                    • <strong>Admin:</strong> admin@gymguide.test / Admin@12345<br>
                    • <strong>Trainer:</strong> john.trainer@gymguide.test / Trainer@12345
                </div>
            </div>
            <div class="card-footer text-center bg-white py-3 border-0">
                New member? <a asp-page="/Account/Register" class="fw-semibold">Create an account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
