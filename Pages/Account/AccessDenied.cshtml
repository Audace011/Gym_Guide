@page
@model GymGuide.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center my-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 p-4">
            <div class="card-body">
                <i class="bi bi-shield-lock-fill text-danger display-1 mb-3"></i>
                <h3 class="fw-bold text-danger">Access Denied</h3>
                <p class="text-muted">
                    You do not have the required role or authorization to view this resource.
                </p>
                <a asp-page="/Index" class="btn btn-primary fw-semibold px-4 mt-2">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
            </div>
        </div>
    </div>
</div>
