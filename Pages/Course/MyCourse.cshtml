@page
@model GymGuide.Pages.Course.MyCourseModel
@{
    ViewData["Title"] = "My Weekly Workout Plan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-calendar2-check text-warning me-2"></i> My Weekly Workout Plan</h3>
        <p class="text-muted small">Follow your personalized exercises tailored to your BMI category and fitness goal</p>
    </div>
    <div>
        <span class="badge bg-success fs-6 py-2 px-3">
            <i class="bi bi-check2-all me-1"></i> Completed Sessions: @Model.CourseData.CompletedSessionsCount
        </span>
    </div>
</div>

@if (TempData["Message"] is string tempMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-1"></i> @tempMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Plan.ActiveCourse == null && !string.IsNullOrEmpty(Model.NoCourseMessage))
{
    <div class="alert alert-info py-4 text-center">
        <i class="bi bi-info-circle fs-1 d-block mb-2"></i>
        <h5>@Model.NoCourseMessage</h5>
        <a asp-page="/Member/Profile" class="btn btn-primary mt-2">Go to Profile</a>
    </div>
}
else if (Model.Plan.ActiveCourse != null)
{
    var course = Model.Plan.ActiveCourse.Course;

    <!-- Active Course Summary Card -->
    <div class="card shadow-sm border-0 mb-4 bg-dark text-white">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-warning text-dark fw-bold mb-2">ACTIVE PROGRAM</span>
                    <h3 class="fw-bold text-white mb-2">@course.Name</h3>
                    <p class="text-light opacity-75 mb-3">@course.Description</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-secondary">Goal: @course.Goal</span>
                        <span class="badge bg-secondary">Level: @course.Level</span>
                        <span class="badge bg-secondary">BMI: @course.Bmicategory</span>
                        <span class="badge bg-secondary">Duration: @course.DurationWeeks Weeks</span>
                        <span class="badge bg-secondary">Started: @Model.Plan.ActiveCourse.StartDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    @if (Model.Plan.LoggedToday)
                    {
                        <button class="btn btn-success btn-lg fw-bold" disabled>
                            <i class="bi bi-check-circle-fill me-1"></i> Today's Workout Done!
                        </button>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="CompleteSession">
                            <input type="hidden" name="memberCourseId" value="@Model.Plan.ActiveCourse.MemberCourseId" />
                            <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark shadow">
                                <i class="bi bi-check-lg me-1"></i> Mark Today as Completed
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Day by Day Exercises -->
    <h4 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-primary"></i> Scheduled Routine</h4>

    @if (Model.Plan.ExercisesByDay.Count > 0)
    {
        <div class="row">
            @foreach (var day in Model.Plan.ExercisesByDay)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-primary text-white py-2 fw-bold">
                            <i class="bi bi-calendar-event me-2"></i> @day.Key
                        </div>
                        <div class="card-body p-3">
                            <div class="list-group list-group-flush">
                                @foreach (var item in day.Value)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-bold text-dark">@item.Exercise.Name</div>
                                                <small class="text-muted">@item.Exercise.MuscleGroup</small>
                                            </div>
                                            <div class="text-end">
                                                @if (item.Sets.HasValue && item.Reps.HasValue && item.Reps > 1)
                                                {
                                                    <span class="badge bg-light text-dark border">@item.Sets sets × @item.Reps reps</span>
                                                }
                                                @if (item.DurationMinutes.HasValue && item.DurationMinutes > 0)
                                                {
                                                    <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@item.DurationMinutes min</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border py-4 text-center">
            No exercises scheduled yet for this course. Please contact your trainer or administrator.
        </div>
    }
}
