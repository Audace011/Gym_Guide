@page
@model GymGuide.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Overview Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-speedometer2 text-warning me-2"></i> Admin Management Dashboard</h3>
        <p class="text-muted small">System summary, active trainer workloads, revenue, and pending assignments</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Admin/CreatePayment" class="btn btn-success btn-sm">
            <i class="bi bi-credit-card me-1"></i> Record Payment
        </a>
        <a asp-page="/Admin/Reports" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> View Reports
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 bg-white">
            <div class="text-muted small fw-bold">TOTAL MEMBERS</div>
            <div class="display-6 fw-bold text-dark">@Model.Dashboard.TotalMembers</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-success border-4 p-3 bg-white">
            <div class="text-muted small fw-bold">TRAINERS</div>
            <div class="display-6 fw-bold text-dark">@Model.Dashboard.TotalTrainers</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 bg-white">
            <div class="text-muted small fw-bold">TRAINING COURSES</div>
            <div class="display-6 fw-bold text-dark">@Model.Dashboard.TotalCourses</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 border-start border-info border-4 p-3 bg-white">
            <div class="text-muted small fw-bold">TOTAL REVENUE</div>
            <div class="display-6 fw-bold text-dark">$@Model.Dashboard.TotalRevenue.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- Pending Requests Alert (if any) -->
@if (Model.Dashboard.PendingRequests.Count > 0)
{
    <div class="card shadow-sm border-0 mb-4 border-start border-danger border-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Pending Trainer Requests (@Model.Dashboard.PendingRequests.Count)</h5>
            <small class="text-muted">Members waiting for available trainers</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Member</th>
                            <th>Requested At</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.Dashboard.PendingRequests)
                        {
                            <tr>
                                <td class="fw-bold">@req.Member.User.FullName (@req.Member.User.Email)</td>
                                <td>@req.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="ResolvePendingRequest" class="d-inline">
                                        <input type="hidden" name="requestId" value="@req.RequestId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-arrow-repeat me-1"></i> Auto-Assign Now
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Trainer Workload Table -->
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill text-primary me-2"></i> Trainer Workload &amp; Capacity</h5>
                <a asp-page="/Admin/Trainers" class="btn btn-outline-secondary btn-sm">Manage</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trainer</th>
                                <th>Specialization</th>
                                <th>Clients</th>
                                <th>Capacity</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Dashboard.TrainerWorkloads)
                            {
                                <tr>
                                    <td class="fw-bold">@t.TrainerName</td>
                                    <td><span class="badge bg-light text-dark border">@t.Specialization</span></td>
                                    <td>@t.CurrentClients / @t.MaxClients</td>
                                    <td style="min-width: 120px;">
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar @(t.WorkloadPercentage >= 100 ? "bg-danger" : "bg-primary")" 
                                                 style="width: @Math.Min(100, t.WorkloadPercentage)%"></div>
                                        </div>
                                        <small class="text-muted">@t.WorkloadPercentage%</small>
                                    </td>
                                    <td>
                                        <span class="badge @(t.IsAvailable ? "bg-success" : "bg-secondary")">
                                            @(t.IsAvailable ? "Available" : "Unavailable")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt text-success me-2"></i> Recent Payments</h5>
                <a asp-page="/Admin/Payments" class="btn btn-outline-secondary btn-sm">All Payments</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Member</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Dashboard.RecentPayments)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Member.User.FullName</td>
                                    <td><small>@p.Plan.Name</small></td>
                                    <td class="text-success fw-bold">$@p.Amount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@p.Method</span></td>
                                </tr>
                            }
                            @if (Model.Dashboard.RecentPayments.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No payments recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
