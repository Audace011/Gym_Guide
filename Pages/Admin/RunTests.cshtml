@page
@model GymGuide.Pages.Admin.RunTestsModel
@{
    ViewData["Title"] = "System Verification Tests";
    int passedCount = Model.Results.Count(r => r.Passed);
    int totalCount = Model.Results.Count;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-shield-check text-success me-2"></i> System Verification & Unit Tests</h3>
        <p class="text-muted small">Live verification of business rules: BMI, Smart Trainer Allocation, Course Recommendations, and Workout Tracking</p>
    </div>
    <div>
        <span class="badge @(passedCount == totalCount ? "bg-success" : "bg-danger") fs-5 px-3 py-2">
            @passedCount / @totalCount Passed
        </span>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Category</th>
                        <th>Test Case Name</th>
                        <th>Details / Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Results)
                    {
                        <tr>
                            <td>
                                @if (t.Passed)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> FAIL</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@t.Category</span></td>
                            <td class="fw-bold">@t.TestName</td>
                            <td class="@(t.Passed ? "text-muted" : "text-danger fw-bold")">@t.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
