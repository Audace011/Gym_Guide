@page
@model GymGuide.Pages.Admin.CreateCourseModel
@{
    ViewData["Title"] = "Create Training Course";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle text-warning me-2"></i> Add New Training Course</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Course.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Course.Name" class="form-control" required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Course.Bmicategory" class="form-label fw-semibold">Target BMI Category</label>
                            <select asp-for="Course.Bmicategory" class="form-select" required>
                                <option value="Underweight">Underweight</option>
                                <option value="Normal">Normal</option>
                                <option value="Overweight">Overweight</option>
                                <option value="Obese">Obese</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Course.Goal" class="form-label fw-semibold">Fitness Goal</label>
                            <select asp-for="Course.Goal" class="form-select" required>
                                <option value="Lose weight">Lose weight</option>
                                <option value="Build muscle">Build muscle</option>
                                <option value="Stay fit">Stay fit</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Course.Level" class="form-label fw-semibold"></label>
                            <select asp-for="Course.Level" class="form-select">
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Course.DurationWeeks" class="form-label fw-semibold">Duration (Weeks)</label>
                            <input asp-for="Course.DurationWeeks" class="form-control" type="number" min="1" max="52" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Course.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Course.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="/Admin/Courses" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark px-4">Create Course</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
