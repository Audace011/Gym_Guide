@page "{id:int}"
@model GymGuide.Pages.Trainer.MemberDetailsModel
@{
    ViewData["Title"] = "Member Fitness Progress & Course";
    var member = Model.Detail.Member;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> @member.User.FullName's Fitness Profile</h3>
        <p class="text-muted small">Email: @member.User.Email | Phone: @(member.User.PhoneNumber ?? "N/A") | Goal: <strong class="text-dark">@member.Goal</strong></p>
    </div>
    <a asp-page="/Trainer/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="row">
    <!-- Active Course & Adjust Form -->
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-award text-warning me-2"></i> Current Training Course</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Detail.ActiveCourse != null)
                {
                    <h5 class="fw-bold text-primary mb-1">@Model.Detail.ActiveCourse.Course.Name</h5>
                    <p class="text-muted small mb-3">@Model.Detail.ActiveCourse.Course.Description</p>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="small text-muted d-block">Level:</span>
                            <strong>@Model.Detail.ActiveCourse.Course.Level</strong>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Target BMI:</span>
                            <strong>@Model.Detail.ActiveCourse.Course.Bmicategory</strong>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Duration:</span>
                            <strong>@Model.Detail.ActiveCourse.Course.DurationWeeks Weeks</strong>
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Sessions Completed:</span>
                            <span class="badge bg-success">@Model.Detail.CompletedSessionsCount</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">No course currently active for this member.</div>
                }

                <hr />

                <!-- Adjust Workout Plan Form -->
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-pencil-square me-1"></i> Adjust / Change Training Plan</h6>
                <p class="text-muted small">Select an alternative course. The current active course will be safely marked as <strong>Replaced</strong>.</p>

                <form method="post" asp-page-handler="AdjustWorkoutPlan">
                    <input type="hidden" name="memberId" value="@member.MemberId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">SELECT NEW COURSE</label>
                        <select name="newCourseId" class="form-select" required>
                            @foreach (var c in Model.Detail.AvailableCourses)
                            {
                                bool isCurrent = Model.Detail.ActiveCourse != null && Model.Detail.ActiveCourse.CourseId == c.CourseId;
                                <option value="@c.CourseId" selected="@(isCurrent ? "selected" : null)">
                                    @c.Name (@c.Goal - @c.Level)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning fw-bold text-dark shadow-sm">
                            <i class="bi bi-arrow-repeat me-1"></i> Update &amp; Activate Plan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Weight & Progress History -->
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i> Weight &amp; BMI Logs</h5>
                <span class="badge bg-light text-dark border">@Model.Detail.WeightHistory.Count total logs</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Weight</th>
                                <th>BMI</th>
                                <th>Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Detail.WeightHistory)
                            {
                                string badge = log.Bmicategory switch
                                {
                                    "Underweight" => "bg-info text-dark",
                                    "Normal" => "bg-success text-white",
                                    "Overweight" => "bg-warning text-dark",
                                    "Obese" => "bg-danger text-white",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td>@log.LoggedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td class="fw-bold">@log.WeightKg kg</td>
                                    <td>@log.Bmi</td>
                                    <td><span class="badge @badge">@log.Bmicategory</span></td>
                                </tr>
                            }
                            @if (Model.Detail.WeightHistory.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No weight logs recorded.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
