@model GymGuide.Models.MembershipPlan
@{
    ViewData["Title"] = "Create Membership Plan";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle text-warning me-2"></i> Add Membership Plan</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreatePlan" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DurationMonths" class="form-label fw-semibold">Duration (Months)</label>
                            <input asp-for="DurationMonths" class="form-control" type="number" min="1" max="36" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Price ($)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="1" required />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IncludesTrainer" id="trainerCheck" />
                        <label class="form-check-label fw-semibold" for="trainerCheck">
                            Includes Personal Trainer Access
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Plans" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">Save Plan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
