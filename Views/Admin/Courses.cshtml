@model List<GymGuide.Models.TrainingCourse>
@{
    ViewData["Title"] = "Manage Training Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-award text-warning me-2"></i> Training Courses</h3>
        <p class="text-muted small">Manage workout programs, fitness goals, and BMI category alignments</p>
    </div>
    <a asp-action="CreateCourse" class="btn btn-warning fw-bold text-dark">
        <i class="bi bi-plus-circle me-1"></i> Add New Course
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course Name</th>
                        <th>Target BMI</th>
                        <th>Fitness Goal</th>
                        <th>Level</th>
                        <th>Duration</th>
                        <th>Scheduled Exercises</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@c.Name</td>
                            <td><span class="badge bg-secondary">@c.Bmicategory</span></td>
                            <td><span class="badge bg-light text-dark border">@c.Goal</span></td>
                            <td>@c.Level</td>
                            <td>@c.DurationWeeks Weeks</td>
                            <td><span class="badge bg-info text-dark">@c.CourseExercises.Count exercises</span></td>
                            <td class="text-end">
                                <a asp-action="EditCourse" asp-route-id="@c.CourseId" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <form asp-action="DeleteCourse" asp-route-id="@c.CourseId" method="post" class="d-inline" onsubmit="return confirm('Delete this course?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
