@model List<GymGuide.Tests.TestResult>
@{
    ViewData["Title"] = "System Unit Tests Runner";
    int passedCount = Model.Count(t => t.Passed);
    int totalCount = Model.Count;
    bool allPassed = passedCount == totalCount && totalCount > 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-shield-check text-success me-2"></i> System Unit Tests Runner</h3>
        <p class="text-muted small">Verification of BMI boundary accuracy and Trainer Assignment logic per Section 10</p>
    </div>
    <a asp-action="RunTests" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-repeat me-1"></i> Re-run All Tests
    </a>
</div>

<div class="card shadow-sm border-0 mb-4 p-4 text-center @(allPassed ? "bg-success text-white" : "bg-warning text-dark")">
    <div class="display-6 fw-bold">
        @(allPassed ? "All Unit Tests Passed Successfully!" : $"{passedCount} of {totalCount} Tests Passed")
    </div>
    <div class="small opacity-75 mt-1">
        Covering: BMI boundary points (18.4, 18.5, 24.9, 25.0, 29.9, 30.0), trainer availability, specialization, capacity limits, and plan replacement.
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Category</th>
                        <th>Test Case Description</th>
                        <th>Outcome / Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in Model)
                    {
                        <tr>
                            <td>
                                @if (test.Passed)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> PASS</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i> FAIL</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@test.Category</span></td>
                            <td class="fw-semibold">@test.TestName</td>
                            <td class="@(test.Passed ? "text-success" : "text-danger fw-bold")">@test.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
