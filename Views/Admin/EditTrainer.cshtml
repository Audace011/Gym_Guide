@model GymGuide.ViewModels.TrainerEditViewModel
@{
    ViewData["Title"] = "Edit Trainer Details";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i> Edit Trainer Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditTrainer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TrainerId" />

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address (Read Only)</label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-semibold"></label>
                            <select asp-for="Specialization" class="form-select" required>
                                <option value="Lose weight">Lose weight</option>
                                <option value="Build muscle">Build muscle</option>
                                <option value="Stay fit">Stay fit</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxClients" class="form-label fw-semibold"></label>
                            <input asp-for="MaxClients" class="form-control" type="number" min="1" max="50" required />
                            <span asp-validation-for="MaxClients" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="availCheck" />
                        <label class="form-check-label fw-semibold" for="availCheck">
                            Available for new member assignments
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Trainers" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
