@model GymGuide.ViewModels.TrainerCreateViewModel
@{
    ViewData["Title"] = "Add New Trainer";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i> Add New Trainer</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateTrainer" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Smith" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="trainer@gym.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+250 7XX XXX XXX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Min 8 chars, 1 uppercase, 1 number, 1 symbol" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text text-muted">The trainer will use this password to log in.</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-semibold"></label>
                            <select asp-for="Specialization" class="form-select" required>
                                <option value="">-- Select Specialization --</option>
                                <option value="Lose weight">Lose weight</option>
                                <option value="Build muscle">Build muscle</option>
                                <option value="Stay fit">Stay fit</option>
                            </select>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxClients" class="form-label fw-semibold"></label>
                            <input asp-for="MaxClients" class="form-control" type="number" min="1" max="50" required />
                            <span asp-validation-for="MaxClients" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="availCheck" checked />
                        <label class="form-check-label fw-semibold" for="availCheck">
                            Available for member assignments immediately
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Trainers" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-person-plus-fill me-1"></i> Create Trainer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
