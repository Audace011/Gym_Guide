@model GymGuide.Models.Exercise
@{
    ViewData["Title"] = "Edit Exercise";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil text-warning me-2"></i> Edit Exercise</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditExercise" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ExerciseId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="MuscleGroup" class="form-label fw-semibold">Muscle Group</label>
                        <select asp-for="MuscleGroup" class="form-select" required>
                            <option value="Chest">Chest</option>
                            <option value="Back">Back</option>
                            <option value="Legs">Legs</option>
                            <option value="Shoulders">Shoulders</option>
                            <option value="Arms">Arms</option>
                            <option value="Core">Core</option>
                            <option value="Cardio">Cardio</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Exercises" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Update Exercise</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
