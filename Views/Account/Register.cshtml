@model GymGuide.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register as a Gym Member";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i> Join GymGuide</h4>
                <small class="text-muted">Enter your personal & body details to get an instant customized workout plan</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="text-primary border-bottom pb-2 mb-3 fw-bold">1. Account Information</h6>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+123456789" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="text-primary border-bottom pb-2 my-3 fw-bold">2. Body Details & Fitness Goal</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HeightCm" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="HeightCm" class="form-control" type="number" step="0.1" placeholder="175" />
                                <span class="input-group-text">cm</span>
                            </div>
                            <span asp-validation-for="HeightCm" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="InitialWeightKg" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="InitialWeightKg" class="form-control" type="number" step="0.1" placeholder="72.5" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="InitialWeightKg" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Goal" class="form-label fw-semibold"></label>
                        <select asp-for="Goal" class="form-select border-warning fw-semibold">
                            <option value="Lose weight">Lose weight</option>
                            <option value="Build muscle">Build muscle</option>
                            <option value="Stay fit">Stay fit</option>
                        </select>
                        <span asp-validation-for="Goal" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Register & Get My Training Plan
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center bg-white py-3 border-0">
                Already have an account? <a asp-action="Login" class="fw-semibold">Log in here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
